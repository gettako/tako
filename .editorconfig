# EditorConfig helps maintain consistent coding styles across various editors and IDEs.
# More information at: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go source files follow standard Go conventions (tabs)
[*.go]
indent_style = tab
indent_size = 4

# Makefiles require real tabs
[Makefile]
indent_style = tab

# Protocol Buffers
[*.proto]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Markdown and MDX documentation (preserve intentional trailing spaces for line breaks)
[*.{md,mdx}]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# Web & Config formats
[*.{json,yaml,yml,toml}]
indent_style = space
indent_size = 2

# Frontend source files
[*.{js,jsx,ts,tsx,css,scss}]
indent_style = space
indent_size = 2
