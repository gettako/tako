{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css",
    "functions": ["clsx", "cn", "cva"],
    "preserveWhitespace": true
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".next/",
    ".turbo/",
    "coverage/",
    "bun.lock",
    "pnpm-lock.yaml",
    ".pnpm-store/"
  ]
}
