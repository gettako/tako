# ==============================================================================
# Tako Console Environment Configuration
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# Go Master Server Backend URL (Tako Control Plane)
#
# Option 1: Connect to a remote master server
# Replace the IP below with your server's IP address:
TAKO_SERVER_URL=http://127.0.0.1:8080

# Option 2: Running backend locally on localhost:
# TAKO_SERVER_URL=http://localhost:8080

# Option 3: Via SSH Port Forwarding if port 8080 is firewalled:
# Run in terminal: ssh -L 8080:127.0.0.1:8080 root@<SERVER_IP>
# Then use:
# TAKO_SERVER_URL=http://127.0.0.1:8080

# Public Console URL for redirects & links
NEXT_PUBLIC_TAKO_SERVER_URL=http://localhost:3000

# Local port for Next.js development server (default: 3000)
PORT=3000
