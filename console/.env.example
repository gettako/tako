# ==============================================================================
# Tako Console Environment Configuration
# Salin file ini menjadi .env:
#   cp .env.example .env
# ==============================================================================

# URL Backend Master Server Go (Tako Control Plane)
# 
# Pilihan 1: Hubungkan ke server demo remote (akses langsung)
# Ganti IP di bawah dengan IP server demo Anda:
TAKO_SERVER_URL=http://194.233.1.2:8080

# Pilihan 2: Jika server backend berjalan di mesin lokal Anda (localhost):
# TAKO_SERVER_URL=http://127.0.0.1:8080

# Pilihan 3: Menggunakan SSH Tunnel jika port 8080 diblokir firewall di server:
# Jalankan di terminal: ssh -L 8080:127.0.0.1:8080 root@<IP_SERVER>
# Lalu gunakan:
# TAKO_SERVER_URL=http://127.0.0.1:8080

# URL Public Console lokal untuk redirect & link
NEXT_PUBLIC_TAKO_SERVER_URL=http://localhost:3000

# Port lokal untuk Next.js dev server (default: 3000)
PORT=3000
