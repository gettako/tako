# ==============================================================================
# Tako Console Environment Variables Example
# Copy this file to .env or .env.local for local development:
#   cp .env.example .env
# ==============================================================================

# Backend Master Server URL (Where REST/SSE API requests are proxied)
# Default for local development: http://127.0.0.1:8080
# Default inside Docker Compose: http://tako-server:8080
TAKO_SERVER_URL=http://127.0.0.1:8080

# Next.js Port (Default: 3000)
PORT=3000

# Application Display Name
NEXT_PUBLIC_APP_NAME=Tako

# Disable Next.js anonymous telemetry data collection
NEXT_TELEMETRY_DISABLED=1
