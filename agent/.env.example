# ==============================================================================
# Tako Worker Agent Configuration
# ==============================================================================

# Master gRPC Endpoint (<master-ip>:50051)
TAKO_MASTER_URL=127.0.0.1:50051

# Node Enrollment Token (must match TAKO_AGENT_SECRET on master)
TAKO_ENROLL_TOKEN=local-master-token

# Node Metadata
TAKO_NODE_NAME=tako-worker-01
TAKO_NODE_ROLE=worker

# Telemetry and State
TAKO_METRICS_INTERVAL=3s
TAKO_STATE_FILE=/tmp/tako-agent.json
TAKO_TRAEFIK_DYNAMIC_DIR=/etc/tako/traefik/dynamic

# Network IP Overrides (optional, auto-detected if left empty)
TAKO_PUBLIC_IP=
TAKO_IP_ADDRESS=
