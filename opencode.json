{
  "$schema": "https://opencode.ai/config.json",
  "model": "sumopod/deepseek-v4.1-flash:netra",
  "providers": {
    "sumopod": {
      "name": "Sumopod",
      "env": ["SUMOPOD_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.sumopod.com/v1"
      },
      "models": {
        "deepseek-v4.1-flash:netra": {
          "name": "DeepSeek V4.1 Flash (Netra)",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "deepseek-v4-flash-0731:netra": {
          "name": "DeepSeek V4-Flash-0731 (Netra)",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    }
  }
}
