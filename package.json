{
  "name": "tako",
  "private": true,
  "workspaces": [
    "console"
  ],
  "scripts": {
    "lint": "bun --filter console lint",
    "format": "bun --filter console format",
    "format:check": "bun --filter console format:check",
    "typecheck": "bun --filter console typecheck",
    "test": "bun --filter console test",
    "api:generate": "bun --filter console api:generate",
    "docs:sync": "bun docs/sync-openapi.ts",
    "docs:check": "bun docs/sync-openapi.ts --check",
    "docs:dev": "mintlify dev --dir docs"
  }
}
