# ==============================================================================
# Configuration template for remote deployment testing
# Copy this file to .env.deploy:
#   cp .env.deploy.example .env.deploy
# ==============================================================================

# Target Host Public IP
TARGET_IP=194.233.1.2

# SSH User and Port
SSH_USER=root
SSH_PORT=22

# Remote working directory on the server
REMOTE_DIR=/opt/tako

# Admin credentials for Console Dashboard & Let's Encrypt ACME
TAKO_EMAIL=admin@gettako.dev
TAKO_PASSWORD=admin123456

# Custom Domain (optional)
TAKO_DOMAIN=
