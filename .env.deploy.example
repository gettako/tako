# ==============================================================================
# Konfigurasi deploy.sh untuk Server Uji Coba
# Salin file ini menjadi .env.deploy:
#   cp .env.deploy.example .env.deploy
# ==============================================================================

# IP Public VPS / Server Anda
TARGET_IP=194.233.1.2

# User dan Port SSH
SSH_USER=root
SSH_PORT=22

# Path direktori kerja di server
REMOTE_DIR=/opt/tako

# Kredensial Admin untuk Console Dashboard & ACME Let's Encrypt
TAKO_EMAIL=admin@gettako.dev
TAKO_PASSWORD=admin123456

# Domain (opsional)
TAKO_DOMAIN=
