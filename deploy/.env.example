# ==============================================================================
# Tako Docker Compose Configuration Template
# Usage:
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/compose.server.yml up -d
# ==============================================================================

# Security and Master Credentials
TAKO_AUTH_SECRET=change-me-to-a-secure-random-secret
TAKO_ENROLL_TOKEN=local-master-token
TAKO_EMAIL=admin@gettako.dev
TAKO_PASSWORD=admin123456

# Traefik Let's Encrypt Email
TAKO_ACME_EMAIL=admin@gettako.dev

# Master / Node Metadata
TAKO_NODE_NAME=tako-master-01
TAKO_NODE_ROLE=leader

# Network IP Configuration (optional)
TAKO_PUBLIC_IP=
TAKO_PRIVATE_IP=
TAKO_HTTP_BIND=0.0.0.0:8080

# Worker Node Only: Remote Master gRPC Endpoint (<master-ip>:50051)
# TAKO_MASTER_URL=192.168.1.50:50051
# TAKO_AGENT_TOKEN=local-master-token
