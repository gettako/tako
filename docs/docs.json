{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Tako",
  "theme": "maple",
  "colors": {
    "primary": "#5560d6",
    "light": "#7980e0",
    "dark": "#3e49be"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://gettako.dev"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/gettako/tako"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://gettako.dev",
      "github": "https://github.com/gettako/tako"
    }
  },
  "api": {
    "baseUrl": "https://api.gettako.dev",
    "examples": {
      "languages": ["bash", "javascript", "go"]
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": [
              "introduction",
              "why-tako",
              "limitations"
            ]
          },
          {
            "group": "Quickstart",
            "icon": "rocket",
            "pages": [
              "quickstart/installation",
              "quickstart/first-deploy"
            ]
          },
          {
            "group": "Core Concepts",
            "icon": "layers",
            "pages": [
              "concepts/architecture",
              "concepts/projects-and-services",
              "concepts/servers-and-agents",
              "concepts/deployments",
              "concepts/domains-and-ssl",
              "concepts/tech-stack"
            ]
          },
          {
            "group": "Guides",
            "icon": "compass",
            "pages": [
              "guides/adding-a-server",
              "guides/connecting-github",
              "guides/environment-variables",
              "guides/rollback",
              "guides/auxiliary-services",
              "guides/databases",
              "guides/team-collaboration"
            ]
          },
          {
            "group": "Self-Hosting",
            "icon": "server",
            "pages": [
              "self-hosting/requirements",
              "self-hosting/backup"
            ]
          },
          {
            "group": "Project",
            "icon": "flag",
            "pages": [
              "roadmap"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Control Plane API",
            "icon": "terminal",
            "openapi": "api-reference/openapi.yaml"
          }
        ]
      }
    ]
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "logo": {
    "light": "/images/tako-logo.svg",
    "dark": "/images/tako-logo-dark.svg",
    "href": "https://gettako.dev",
    "width": 72
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "fonts": {
    "family": "Inter"
  }
}
