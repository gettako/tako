{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Tako",
  "theme": "maple",
  "colors": {
    "primary": "#5560d6",
    "light": "#7980e0",
    "dark": "#3e49be"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://gettako.dev"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/gettako/tako"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://gettako.dev",
      "github": "https://github.com/gettako/tako"
    }
  },
  "api": {
    "baseUrl": "https://api.gettako.dev",
    "examples": {
      "languages": ["bash", "javascript", "go"]
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": [
              "introduction",
              "why-tako"
            ]
          },
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "quickstart/installation",
              "quickstart/first-deploy"
            ]
          },
          {
            "group": "Architecture & Internals",
            "icon": "cpu",
            "pages": [
              "architecture/overview",
              "architecture/agent-protocol",
              "architecture/deployment-lifecycle",
              "architecture/reverse-proxy"
            ]
          },
          {
            "group": "Guides & Workflows",
            "icon": "compass",
            "pages": [
              "guides/deploying-apps",
              "guides/github-integration",
              "guides/domains-and-ssl",
              "guides/environment-variables",
              "guides/terminal-and-exec",
              "guides/runtime-logs",
              "guides/cron-jobs-and-webhooks",
              "guides/adding-worker-nodes",
              "guides/databases-and-volumes",
              "guides/s3-storage-and-backups",
              "guides/notifications-and-alerts",
              "guides/security-and-auth",
              "guides/monitoring-and-ingress",
              "guides/system-upgrades",
              "guides/troubleshooting"
            ]
          },
          {
            "group": "Reference",
            "icon": "terminal",
            "pages": [
              "reference/configuration",
              "reference/cli"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Control Plane REST API",
            "icon": "code",
            "openapi": "api-reference/openapi.yaml"
          }
        ]
      }
    ]
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "logo": {
    "light": "/images/tako-logo.svg",
    "dark": "/images/tako-logo-dark.svg",
    "href": "https://gettako.dev",
    "width": 72
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "fonts": {
    "family": "Inter"
  }
}
