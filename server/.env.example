# ==============================================================================
# Tako Master Server Configuration
# ==============================================================================

# Runtime environment (development / production)
TAKO_ENV=development

# Network Ports
TAKO_HTTP_PORT=8080
TAKO_GRPC_PORT=50051

# SQLite Database storage path
TAKO_DB_PATH=tako.db

# Authentication and Secret Keys
TAKO_AUTH_SECRET=dev-secret-key-change-me-in-production
TAKO_AGENT_SECRET=local-master-token

# Bootstrap Initial Administrator Credentials
TAKO_INITIAL_ADMIN_EMAIL=admin@gettako.dev
TAKO_INITIAL_ADMIN_PASSWORD=admin123456

# Master Node Identifier
TAKO_NODE_NAME=tako-master-01
